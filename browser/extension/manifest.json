{
  "manifest_version": 3,
  "name": "IDM Clone",
  "version": "1.0",
  "description": "Download with IDM Clone",
  "permissions": [
    "downloads",
    "contextMenus",
    "nativeMessaging",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "IDM Clone",
    "default_popup": "popup.html"
  }
}